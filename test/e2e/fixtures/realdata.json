   "sections": {
    "事業構造": {
     "t": "主力は空気工具・機械工具と、迅速流体継手(カプラ)の二本柱。カプラは産業用の配管接続部品で、一度採用されると設備更新まで置き換わりにくく、補修需要が景気変動に対して緩衝材として働く。空気工具は設備投資サイクルの影響を受けやすく、両者を合わせることで振れ幅を抑える構造になっている。",
     "d": "2026/8/14",
     "details": [
      {
       "ts": "2026/8/14",
       "title": "AI深掘り",
       "t": "カプラは同社が国内シェア首位で、規格が事実上の業界標準になっている。互換品はあるが、既設配管との接続保証を理由に純正が選ばれ続けている。この参入障壁が利益率の源泉。"
      },
      {
       "ts": "2026/7/2",
       "title": "AI深掘り",
       "t": "空気工具は競合が多く価格競争になりやすい。ただし工具単体ではなくライン全体の提案で受注する形に移行しており、単価下落を数量で吸収できている。"
      }
     ]
    },
    "収益モデル": {
     "t": "製品売切りが中心で、ストック性は補修部品の交換需要に依存する。サブスクリプション的な継続収入は持たない。",
     "d": "2026/8/14"
    },
    "顧客セグメント": {
     "t": "国内が売上の約6割、残りを北米・欧州・アジアで分け合う。北米は建設・インフラ向けの比率が高く、住宅着工件数との相関が見られる。アジアは中国の設備投資の影響を受けやすいが、直近は東南アジア向けが伸びており、中国依存の低下が進んでいる。",
     "d": "2026/8/14",
     "details": [
      {
       "ts": "2026/8/14",
       "title": "AI深掘り",
       "t": "最終需要は自動車・建設機械・造船・食品加工と幅広く、単一業種への依存は低い。ただし全体が設備投資という一つのサイクルに乗っているため、分散しているように見えて景気後退局面では同時に落ちる。"
      }
     ]
    },
    "市場規模(TAM/SAM/SOM)": {
     "t": "国内の産業用継手市場は年1,200億円規模で成熟。成長は海外、特に東南アジアのインフラ投資に依存する。",
     "d": "2026/8/14"
    },
    "市場成長率": {
     "t": "国内は横ばい〜微減。海外は年3〜5%成長を想定。",
     "d": "2026/7/2"
    },
    "主要競合": {
     "t": "国内は日東工器がカプラで首位。空気工具は瓜生製作、ヨコタ工業等と競合。海外はParker Hannifin、Stauffが強い。",
     "d": "2026/8/14"
    },
    "競争優位性・差別化": {
     "t": "規格の標準化と、全国の代理店網による即日供給体制。故障時に即入手できることが選定理由の上位に来るため、在庫を持つ体力が参入障壁になっている。",
     "d": "2026/8/14"
    },
    "技術力": {
     "t": "自動車の電動化により、従来の内燃機関向け組立ラインで使われていた工具需要は中長期で減少が見込まれる。一方で電池モジュールの組立工程では新たな締結・接続需要が生まれており、置き換えが進むかどうかが分水嶺になる。",
     "d": "2026/8/14",
     "details": [
      {
       "ts": "2026/8/14",
       "title": "AI深掘り",
       "t": "研究開発費は売上比3%前後で、同業比では標準的。大きな技術的飛躍より、既存製品の小刻みな改良を積み上げる方針。"
      },
      {
       "ts": "2026/6/18",
       "title": "AI深掘り",
       "t": "省人化ニーズを取り込む自動接続機構の開発が進行中。人手不足が深刻な現場ほど採用の動機が強く、単価も上げやすい。"
      }
     ]
    },
    "実績財務(PL/BS/CF)": {
     "t": "営業CFは安定して黒字。投資CFは設備更新中心で年15〜19億円。FCFは継続して黒字を確保しており、配当を賄って余りある水準。",
     "d": "2026/8/14"
    },
    "財務健全性・効率性": {
     "t": "自己資本比率74%、有利子負債はほぼ無し。手元現金は年商の約半分に相当し、財務面の懸念は小さい。ただし資本効率の観点ではROE10%前後にとどまり、余剰資本の使途が課題。",
     "d": "2026/8/14"
    },
    "事業リスク": {
     "t": "自動車の電動化による工具需要の構造変化、中国の設備投資減速、原材料(鋼材)価格の変動が主なリスク。",
     "d": "2026/8/14"
    },
    "法務リスク": {
     "t": "産業機械の安全規格(ISO/JIS)の改訂により、既存製品の再認証が必要になる可能性がある。",
     "d": "2026/7/2"
    },
    "配当方針": {
     "t": "配当性向35%前後を維持する方針を明示。累進配当ではないが、減配実績は直近10年で無い。年間配当は70円→95円(予)と増配基調。",
     "d": "2026/8/14"
    },
    "自社株買い": {
     "t": "直近3年で2回実施。",
     "d": "2026/7/2"
    },
    "総還元性向": {
     "t": "配当と自社株買いを合わせると50%を超える年もある。",
     "d": "2026/7/2"
    },
    "経営陣の質": {
     "t": "創業家出身ではない生え抜き社長。在任5年で海外比率を10ポイント引き上げた実績がある。",
     "d": "2026/7/2"
    },
    "資本政策": {
     "t": "余剰現金の使途が明示されておらず、ROE改善に向けた資本政策の踏み込みが投資家からの主な要望になっている。",
     "d": "2026/8/14"
    }
   },
